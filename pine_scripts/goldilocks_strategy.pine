//@version=6
strategy("Goldilocks 7RR Strategy Backtester", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.cash_per_contract, commission_value=0.5)

// --- 1. EMA Calculations ---
ema25 = ta.ema(close, 25)
ema100 = ta.ema(close, 100)

plot(ema25, color=color.aqua, title="25 EMA", linewidth=2)
plot(ema100, color=color.fuchsia, title="100 EMA", linewidth=2)

// --- 2. ATR Calculation ---
my_atr = ta.atr(14)
trade_risk = math.max(2.0 * my_atr, 5.0)

// --- 3. Signal Logic ---
longCondition = ta.crossover(ema25, ema100)

// Variable to store the risk calculated on the exact candle of the crossover
var float saved_risk = na

// --- 4. Order Execution ---
// Check if crossover is true AND we have no open trades (enforces 1-trade-at-a-time rule)
if (longCondition and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)
    saved_risk := trade_risk

// --- 5. Trade Management (Stop Loss & Take Profit) ---
if (strategy.position_size > 0)
    // strategy.position_avg_price gives the exact execution fill price
    sl_price = strategy.position_avg_price - saved_risk
    tp_price = strategy.position_avg_price + (saved_risk * 7.0)
    
    // Automatically submits limit and stop orders to close the position
    strategy.exit("Exit", "Long", limit=tp_price, stop=sl_price)
